# SQLite database file (used by Prisma)
DATABASE_URL="file:./dev.db"

# Random secret used by NextAuth to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: Anthropic API key. If unset, the AI itinerary generator
# falls back to a built-in template-based generator.
ANTHROPIC_API_KEY=""
